#!/usr/bin/env python3
"""A fake sprite CLI for the tests. It logs every call (with stdin) as JSON
lines to FAKE_SPRITE_LOG and keeps Sprites and their policies in the
FAKE_SPRITE_STATE directory. Knobs, all environment variables:
  FAKE_NOT_LOGGED_IN   org list and list fail
  FAKE_CREATE_FAIL     create fails (FAKE_CREATE_STDERR is its message)
  FAKE_FAIL            a substring: any call whose words contain it fails
  FAKE_INSIDE_POLICY   what the Sprite reports at /.sprite/policy/network.json
  FAKE_NO_INSIDE_POLICY  the Sprite has no /.sprite/policy/network.json
  FAKE_API_POLICY      what a GET of /policy/network reports
  FAKE_LOGIN_STATUS    exit status of agent-login.sh status (FAKE_LOGIN_AGENT prints)
  FAKE_EXEC_STDOUT     printed by any other exec
"""
import json, os, sys

args = sys.argv[1:]
env = os.environ.get
state = env("FAKE_SPRITE_STATE")
os.makedirs(state, exist_ok=True)
stdin = ""
if args and args[0] in ("exec", "x", "api") and not sys.stdin.isatty():
    stdin = sys.stdin.read()
entry = {"args": args}
if stdin:
    entry["stdin"] = stdin
with open(env("FAKE_SPRITE_LOG"), "a") as log:
    log.write(json.dumps(entry) + "\n")


def fail(message, code=1):
    print(message, file=sys.stderr)
    sys.exit(code)


if env("FAKE_FAIL") and any(env("FAKE_FAIL") in a for a in args):
    fail("fake failure")
names_path = os.path.join(state, "names.json")
names = json.load(open(names_path)) if os.path.exists(names_path) else []


def save():
    json.dump(names, open(names_path, "w"))


def flag(name, default=None):
    return args[args.index(name) + 1] if name in args else default


def policy_path(name, kind):
    return os.path.join(state, f"{name}.{kind}.json")


def read_policy(name, kind):
    path = policy_path(name, kind)
    if os.path.exists(path):
        return open(path).read()
    return '{"rules": []}' if kind == "network" else "{}"


cmd = args[0] if args else ""
if cmd == "org" and args[1:2] == ["list"]:
    if env("FAKE_NOT_LOGGED_IN"):
        fail("not logged in")
    print("Organizations:\n  team (current)")
elif cmd in ("list", "ls"):
    if env("FAKE_NOT_LOGGED_IN"):
        fail("not logged in")
    prefix = flag("--prefix", "")
    print("NAME STATUS")
    for n in names:
        if n.startswith(prefix):
            print(f"{n} {env('FAKE_STATUS', 'warm')}")
elif cmd == "create":
    if env("FAKE_CREATE_FAIL"):
        fail(env("FAKE_CREATE_STDERR", "create failed"))
    names.append(args[-1])
    save()
elif cmd == "destroy":
    if args[-1] in names:
        names.remove(args[-1])
        save()
elif cmd in ("exec", "x"):
    words = args[args.index("--") + 1:]
    line = " ".join(words)
    if words[:2] == ["sh", "-c"] and "/.sprite/policy/network.json" in line:
        if not env("FAKE_NO_INSIDE_POLICY"):
            print(env("FAKE_INSIDE_POLICY") or read_policy(flag("-s"), "network"))
    elif "agent-login.sh" in line and words[-1] == "status":
        print(env("FAKE_LOGIN_AGENT", "codex"))
        sys.exit(int(env("FAKE_LOGIN_STATUS", "0")))
    elif env("FAKE_EXEC_STDOUT"):
        print(env("FAKE_EXEC_STDOUT"))
elif cmd == "api":
    name = flag("-s")
    path = [a for a in args[1:args.index("--")] if a.startswith("/")][0]
    kind = path.rsplit("/", 1)[-1]
    if "POST" in args:
        json.loads(stdin)
        open(policy_path(name, kind), "w").write(stdin)
    elif kind == "network" and env("FAKE_API_POLICY"):
        print(env("FAKE_API_POLICY"))
    else:
        print(read_policy(name, kind))
