#!/usr/bin/env bash
# Host setup: link bxn into ~/.local/bin and, when chosen, install
# Chadmux, Chad's opinionated tmux config. Bash 3.2 compatible.
set -euo pipefail
PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

log()  { printf '[+] %s\n' "$*"; }
warn() { printf '[!] %s\n' "$*" >&2; }
die()  { printf 'install: %s\n' "$*" >&2; exit 1; }

# Chadmux: ask (interactive only), yes, or no.
CHADMUX=ask
while [[ $# -gt 0 ]]; do
  case "$1" in
    --chadmux) CHADMUX=yes; shift ;;
    --no-chadmux) CHADMUX=no; shift ;;
    -h|--help)
      printf 'Usage: %s [--chadmux|--no-chadmux]\n' "$(basename "$0")"
      printf '  --chadmux     Install the Chadmux tmux config on this host without asking\n'
      printf '  --no-chadmux  Skip the Chadmux question\n'
      exit 0 ;;
    *) die "Unknown option: $1" ;;
  esac
done

source "$PROJECT_DIR/lib/chadmux.sh"

bin_dir="$HOME/.local/bin"
target="$bin_dir/bxn"
mkdir -p "$bin_dir"
chmod +x "$PROJECT_DIR/bxn"
if [[ -L "$target" ]]; then
  rm "$target"
elif [[ -e "$target" ]]; then
  reply=""
  if [[ -t 0 ]]; then read -rp "$target exists and is not a link. Replace it? [y/N] " reply || reply=""; fi
  if [[ "$reply" =~ ^[Yy]$ ]]; then
    rm "$target"
  else
    warn "Keeping $target; bxn was not linked"
    target=""
  fi
fi
if [[ -n "$target" ]]; then
  # The launcher resolves the link, so lib/ and v3/ stay in this checkout.
  ln -s "$PROJECT_DIR/bxn" "$target"
  log "Linked $target -> $PROJECT_DIR/bxn"
fi
# The launcher was called boxen; a link by that name into this checkout now
# dangles, so drop it. A boxen that is something else is left alone.
old="$bin_dir/boxen"
if [[ -L "$old" && "$(readlink "$old")" == "$PROJECT_DIR/boxen" ]]; then
  rm "$old"
  log "Removed the old $old link"
fi

# Chadmux is off unless chosen, and an existing host tmux config is always
# left alone. It is a host setup; sandboxes do not get it.
state="$(chadmux_status)"
case "$state" in
  installed)
    log 'Chadmux is already installed on this host' ;;
  existing\ *)
    if [[ "$CHADMUX" != no ]]; then log "Keeping your tmux config at ${state#existing } (Chadmux not installed)"; fi ;;
  missing\ *)
    if [[ "$CHADMUX" != no ]]; then warn "Chadmux needs ${state#missing } on this host; skipping"; fi ;;
  incomplete)
    # Chosen before, but TPM is missing; finishing touches only ~/.tmux/plugins.
    if [[ "$CHADMUX" != no ]]; then
      warn 'Chadmux config is installed, but TPM is missing'
      if [[ "$CHADMUX" == ask && -t 0 ]]; then
        read -rp 'Finish Chadmux setup by installing TPM? [Y/n] ' reply || reply=""
        if [[ ! "$reply" =~ ^[Nn]$ ]]; then CHADMUX=yes; fi
      fi
      if [[ "$CHADMUX" == yes ]]; then
        (chadmux_install) || warn 'TPM setup failed; run ./install --chadmux again to retry'
      else
        warn 'Run ./install --chadmux to finish TPM setup'
      fi
    fi ;;
  absent)
    if [[ "$CHADMUX" == ask && -t 0 ]]; then
      echo
      echo "Chadmux is Chad's opinionated tmux config, with TPM plugins for the Dracula"
      echo "theme, tmux-yank and vim-tmux-navigator."
      read -rp 'Install Chadmux tmux config on this host? [y/N] ' reply || reply=""
      if [[ "$reply" =~ ^[Yy]$ ]]; then CHADMUX=yes; fi
    fi
    if [[ "$CHADMUX" == yes ]]; then
      (chadmux_install) || warn 'Chadmux install failed; bxn is still installed'
    elif [[ "$CHADMUX" == ask ]]; then
      log 'Chadmux not installed; run ./install --chadmux to add it'
    fi ;;
esac

if [[ ":$PATH:" != *":$bin_dir:"* ]]; then
  warn "$bin_dir is not in your PATH. Add to ~/.zshrc or ~/.bashrc:"
  printf '  export PATH="$HOME/.local/bin:$PATH"\n'
fi

# sbx lets a third-party kit use a credential only after the user approves a
# binding for that service, through a prompt on the kit's first interactive
# run; Docker's own kits need none. Boxen's workload is third-party, so every
# credential its sandboxes use needs one, and Boxen starts every sandbox
# detached, so the prompt is never seen. Without a binding the credential is
# withheld: the gh-auth mixin's token never reaches GitHub, a stored agent key
# never reaches its service, and the proxy refuses Claude Code's sign-in from
# inside the sandbox ("OAuth refresh denied (no authorizing binding)") because
# it manages that sign-in's token exchange. Bindings are approval records,
# not secrets. The oauth domains are each kit's token endpoint host plus the
# hosts it injects into; the apiKey domains are the hosts it injects into.
credentials="${BOXEN_SBX_CREDENTIALS:-$HOME/.config/sbx/credentials.yaml}"
header="# Written by boxen's install. Approves the credentials Boxen's kits use: the gh-auth"
bindings='bindings:
  github:
    apiKey:
      domains: [api.github.com, github.com, gist.github.com]
  anthropic:
    apiKey:
      domains: [api.anthropic.com, console.anthropic.com, claude.ai, mcp-proxy.anthropic.com]
    oauth:
      domains: [platform.claude.com, api.anthropic.com, console.anthropic.com, claude.ai, mcp-proxy.anthropic.com]
  openai:
    apiKey:
      domains: [api.openai.com, openai.com]
    oauth:
      domains: [auth.openai.com, chatgpt.com, api.openai.com, openai.com]
  xai:
    apiKey:
      domains: [api.x.ai]'
wanted="$header
# mixin's github secret and the Claude, Codex and Grok agents' own services.
$bindings"
# The services a stranger's file must mention, and the block for each.
binding_block() {
  local line keep=0
  while IFS= read -r line; do
    case "$line" in "  $1:") keep=1 ;; "  "[a-z]*:) keep=0 ;; esac
    [[ "$keep" == 0 ]] || printf '%s\n' "$line"
  done <<< "$bindings"
}
restart_note() {
  # sandboxd reads the file when it starts and not again.
  echo 'If sbx is already running, run: sbx daemon restart (stops running sandboxes;'
  echo 'resume one with sbx run -d --name NAME). Until then the credentials are withheld.'
}
if [[ ! -e "$credentials" ]]; then
  mkdir -p "$(dirname "$credentials")"
  printf '%s\n' "$wanted" > "$credentials"
  log "Approved the kits' credentials (github, anthropic, openai, xai) in $credentials"
  restart_note
elif { IFS= read -r first < "$credentials"; [[ "$first" == '# Written by boxen'* ]]; }; then
  # Boxen's own file: bring it up to date, as an older install wrote github only.
  if [[ "$(cat "$credentials")" == "$wanted" ]]; then
    log "Credential bindings present in $credentials"
  else
    printf '%s\n' "$wanted" > "$credentials"
    log "Updated the credential bindings in $credentials (github, anthropic, openai, xai)"
    restart_note
  fi
else
  missing=""
  for service in github anthropic openai xai; do
    grep -Eq "^[[:space:]]+$service:[[:space:]]*$" "$credentials" || missing="$missing $service"
  done
  if [[ -z "$missing" ]]; then
    log "Credential bindings present in $credentials"
  else
    warn "$credentials exists without bindings for:$missing. Those credentials are withheld from sandboxes until it holds:"
    for service in $missing; do binding_block "$service" | sed 's/^/  /'; done
  fi
fi
log 'Done. Next: bxn doctor'
