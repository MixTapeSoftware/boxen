#!/usr/bin/env bash
# Host setup: link boxen into ~/.local/bin and, when chosen, install
# Chadmux, Chad's opinionated tmux config. Bash 3.2 compatible.
set -euo pipefail
PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

log()  { printf '[+] %s\n' "$*"; }
warn() { printf '[!] %s\n' "$*" >&2; }
die()  { printf 'install: %s\n' "$*" >&2; exit 1; }

# Chadmux: ask (interactive only), yes, or no.
CHADMUX=ask
while [[ $# -gt 0 ]]; do
  case "$1" in
    --chadmux) CHADMUX=yes; shift ;;
    --no-chadmux) CHADMUX=no; shift ;;
    -h|--help)
      printf 'Usage: %s [--chadmux|--no-chadmux]\n' "$(basename "$0")"
      printf '  --chadmux     Install the Chadmux tmux config on this host without asking\n'
      printf '  --no-chadmux  Skip the Chadmux question\n'
      exit 0 ;;
    *) die "Unknown option: $1" ;;
  esac
done

source "$PROJECT_DIR/lib/chadmux.sh"

bin_dir="$HOME/.local/bin"
target="$bin_dir/boxen"
mkdir -p "$bin_dir"
chmod +x "$PROJECT_DIR/boxen"
if [[ -L "$target" ]]; then
  rm "$target"
elif [[ -e "$target" ]]; then
  reply=""
  if [[ -t 0 ]]; then read -rp "$target exists and is not a link. Replace it? [y/N] " reply || reply=""; fi
  if [[ "$reply" =~ ^[Yy]$ ]]; then
    rm "$target"
  else
    warn "Keeping $target; boxen was not linked"
    target=""
  fi
fi
if [[ -n "$target" ]]; then
  # The launcher resolves the link, so lib/ and v3/ stay in this checkout.
  ln -s "$PROJECT_DIR/boxen" "$target"
  log "Linked $target -> $PROJECT_DIR/boxen"
fi

# Chadmux is off unless chosen, and an existing host tmux config is always
# left alone. It is a host setup; sandboxes do not get it.
state="$(chadmux_status)"
case "$state" in
  installed)
    log 'Chadmux is already installed on this host' ;;
  existing\ *)
    if [[ "$CHADMUX" != no ]]; then log "Keeping your tmux config at ${state#existing } (Chadmux not installed)"; fi ;;
  missing\ *)
    if [[ "$CHADMUX" != no ]]; then warn "Chadmux needs ${state#missing } on this host; skipping"; fi ;;
  incomplete)
    # Chosen before, but TPM is missing; finishing touches only ~/.tmux/plugins.
    if [[ "$CHADMUX" != no ]]; then
      warn 'Chadmux config is installed, but TPM is missing'
      if [[ "$CHADMUX" == ask && -t 0 ]]; then
        read -rp 'Finish Chadmux setup by installing TPM? [Y/n] ' reply || reply=""
        if [[ ! "$reply" =~ ^[Nn]$ ]]; then CHADMUX=yes; fi
      fi
      if [[ "$CHADMUX" == yes ]]; then
        (chadmux_install) || warn 'TPM setup failed; run ./install --chadmux again to retry'
      else
        warn 'Run ./install --chadmux to finish TPM setup'
      fi
    fi ;;
  absent)
    if [[ "$CHADMUX" == ask && -t 0 ]]; then
      echo
      echo "Chadmux is Chad's opinionated tmux config, with TPM plugins for the Dracula"
      echo "theme, tmux-yank and vim-tmux-navigator."
      read -rp 'Install Chadmux tmux config on this host? [y/N] ' reply || reply=""
      if [[ "$reply" =~ ^[Yy]$ ]]; then CHADMUX=yes; fi
    fi
    if [[ "$CHADMUX" == yes ]]; then
      (chadmux_install) || warn 'Chadmux install failed; boxen is still installed'
    elif [[ "$CHADMUX" == ask ]]; then
      log 'Chadmux not installed; run ./install --chadmux to add it'
    fi ;;
esac

if [[ ":$PATH:" != *":$bin_dir:"* ]]; then
  warn "$bin_dir is not in your PATH. Add to ~/.zshrc or ~/.bashrc:"
  printf '  export PATH="$HOME/.local/bin:$PATH"\n'
fi

# sbx lets a third-party kit use a stored secret only after the user approves
# a binding for that service, through a prompt on the kit's first interactive
# run. Boxen starts every sandbox detached, so the prompt is never seen and
# the gh-auth mixin's token would be withheld: GitHub then receives the
# placeholder. The binding is an approval record, not a secret.
credentials="${BOXEN_SBX_CREDENTIALS:-$HOME/.config/sbx/credentials.yaml}"
binding='bindings:
  github:
    apiKey:
      domains: [api.github.com, github.com, gist.github.com]'
if [[ ! -e "$credentials" ]]; then
  mkdir -p "$(dirname "$credentials")"
  printf '# Written by boxen'"'"'s install. Approves the gh-auth mixin'"'"'s use of the github secret.\n%s\n' "$binding" > "$credentials"
  log "Approved the gh-auth mixin's GitHub credential in $credentials"
elif grep -Eq '^[[:space:]]+github:[[:space:]]*$' "$credentials"; then
  log "GitHub credential binding present in $credentials"
else
  warn "$credentials exists without a github binding; gh-auth sandboxes get no token until it holds:"
  printf '%s\n' "$binding" | sed 's/^/  /'
fi
echo
log 'For --tailscale sandboxes. Add this to your tailnet policy:'
cat <<'EOF'
  {
    "tagOwners": {"tag:boxen": ["autogroup:admin"]},
    "acls": [
      {
        "action": "accept", "proto": "tcp",
        "src": ["autogroup:member"],
        "dst": ["tag:boxen:443,4410,4431,5432,5433,5434,8443"]
      }
    ]
    // No "funnel" nodeAttrs entry may target tag:boxen or "*".
  }
EOF
echo 'It is an addition to your existing rules, not a replacement for them: merge the'
echo 'tagOwners and the acl into your policy. Any other rule that already reaches'
echo 'tag:boxen, such as the default allow-all, still applies.'
echo
echo 'There is more than one way to write this. If your policy already says who may'
echo 'reach everything, that rule covers sandboxes too and the acl above adds nothing:'
echo '  {"action": "accept", "src": ["group:admin"], "dst": ["*:*"]}'
echo 'What matters either way: tag:boxen is in tagOwners, no rule has tag:boxen as'
echo 'src, and no funnel nodeAttrs entry names it. Read up before editing:'
echo 'https://tailscale.com/kb/1018/acls and the README, "Tailscale and previews".'
log 'Done. Next: boxen doctor'
