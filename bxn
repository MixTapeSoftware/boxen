#!/usr/bin/env bash
# Boxen's launcher: development Sprites on Fly.io for coding agents. Bash 3.2
# compatible.
set -euo pipefail
# Resolve symlinks: a link in ~/.local/bin must still find lib/, guest/ and
# plugins/ next to the real file. macOS 12 and earlier have no realpath.
resolve() {
  if command -v realpath >/dev/null 2>&1; then realpath "$1"; return; fi
  local p="$1" link
  while [[ -L "$p" ]]; do
    link="$(readlink "$p")"
    case "$link" in /*) p="$link" ;; *) p="$(dirname "$p")/$link" ;; esac
  done
  printf '%s\n' "$p"
}
PROJECT_DIR="$(cd "$(dirname "$(resolve "${BASH_SOURCE[0]}")")" && pwd)"
source "$PROJECT_DIR/lib/prompt.sh"
source "$PROJECT_DIR/lib/box.sh"
source "$PROJECT_DIR/lib/cli.sh"
source "$PROJECT_DIR/lib/tui.sh"
main "$@"
