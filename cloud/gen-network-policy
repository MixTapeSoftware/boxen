#!/usr/bin/env bash
# Writes cloud/network-policy/network-policy.yaml: a declaration-only v3 mixin
# allowing every host the kits and agents declare. Cloud sandboxes take their
# policy at creation, so attach it then:
#   sbx --cloud run docker/sbx-kit-claude:TAG --name NAME --kit ./cloud/network-policy
set -euo pipefail
dir="$(cd "$(dirname "$0")" && pwd)"
root="$(dirname "$dir")"
out="$dir/network-policy/network-policy.yaml"
mkdir -p "$(dirname "$out")"
# Write beside the policy and move it into place only when every spec was
# read, so a failed run leaves the previous policy untouched.
tmp="$(mktemp "$out.XXXXXX")"
trap 'rm -f "$tmp"' EXIT
{
  printf '# syntax=docker/sandbox-kit:3\n'
  printf '# Generated by cloud/gen-network-policy from the kit and agent specs. Edit those, then rerun it.\n'
  printf 'schemaVersion: "3"\n'
  printf 'displayName: Boxen network policy\n'
  printf 'description: Every host the Boxen kits and agents allow, for cloud sandboxes\n'
  printf 'kind: mixin\n'
  printf 'provides: ["boxen-network-policy@1.0.0"]\n'
  printf 'capabilities:\n'
  printf '  - type: com.docker.sandbox/network-policy@2\n'
  printf '    config:\n'
  printf '      runtime:\n'
  printf '        allow:\n'
  for spec in "$root"/kits/*/spec.yaml "$root"/agents/*/spec.yaml; do
    # Block lists (- host) and flow lists (allow: [a, b]) both occur; a spec
    # with a permissions block that yields no host stops the run.
    awk -v name="$(basename "$(dirname "$spec")")" '
      /^permissions:/ { p = 1; seen = 1; next }
      p && /^[^ ]/ { p = 0 }
      p && /^ *- / { sub(/^ *- /, ""); sub(/ *#.*/, ""); hosts[++n] = $0 }
      p && /allow: *\[/ {
        s = $0; sub(/.*\[/, "", s); sub(/\].*/, "", s)
        m = split(s, items, ",")
        for (i = 1; i <= m; i++) { gsub(/^ +| +$/, "", items[i]); if (items[i] != "") hosts[++n] = items[i] }
      }
      END {
        if (seen && !n) { printf "%s: permissions block with no hosts I can read\n", name > "/dev/stderr"; exit 1 }
        if (n) {
          printf "          # %s\n", name
          for (i = 1; i <= n; i++) printf "          - %s\n", hosts[i]
        }
      }
    ' "$spec"
  done
} > "$tmp"
mv "$tmp" "$out"
trap - EXIT
echo "Wrote $out"
